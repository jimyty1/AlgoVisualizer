{
    "tasks": [
        {
            "label": "Build Main",
            "type": "shell",
            "command": "gcc",
            "args": [
                "main.c",
                "sortingalgos.c",
                "-o",
                "main"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "gcc",
            "args": [
                "tests.c",
                "sortingalgos.c",
                "-o",
                "tests"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Main",
            "type": "shell",
            "command": "gcc main.c sortingalgos.c -o main && ./main",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "gcc tests.c sortingalgos.c -o tests && ./tests",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ],
    "version": "2.0.0"
}