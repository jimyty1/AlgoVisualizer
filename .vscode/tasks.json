{
    "tasks": [
        {
            "label": "Build Main",
            "type": "shell",
            "command": "gcc",
            "args": [
                "main.c",
                "sortingalgos.c",
                "visualizer.c",
                "-o",
                "main"
            ],
            "options": {
                "cwd": "${workspaceFolder}/logic"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "gcc",
            "args": [
                "tests.c",
                "sortingalgos.c",
                "visualizer.c",
                "-o",
                "tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}/logic"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Main",
            "type": "shell",
            "command": "./main",
            "options": {
                "cwd": "${workspaceFolder}/logic"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "./tests",
            "options": {
                "cwd": "${workspaceFolder}/logic"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C/C++: clang build active file",
            "type": "shell",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build active C file"
        }
    ],
    "version": "2.0.0"
}